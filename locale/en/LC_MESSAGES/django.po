msgid "Mis órdenes"
msgstr "My orders"

msgid "Mis cotizaciones"
msgstr "My quotes"

msgid "Mi QR"
msgstr "My QR"

msgid "TradeFlow Colón — Compra, gestiona, exporta"
msgstr "TradeFlow Colón — Buy, manage, export"

msgid "Zona Libre de Colón · Panamá"
msgstr "Colón Free Zone · Panama"

msgid "La ZLC en una plataforma B2B en la que confían compradores y operadores"
msgstr "The CFZ on a B2B platform trusted by buyers and operators"

msgid ""
"TradeFlow conecta compradores con empresas verificadas de la Zona Libre de "
"Colón: catálogo claro, pedidos trazables y herramientas listas para escalar "
"ante inversores y socios logísticos."
msgstr ""
"TradeFlow connects buyers with verified Colón Free Zone companies: a clear "
"catalog, traceable orders, and tools ready to scale with investors and "
"logistics partners."

msgid "Crear cuenta"
msgstr "Create account"

msgid "Iniciar sesión"
msgstr "Log in"

msgid "Empresas en la ZLC"
msgstr "Companies in the CFZ"

msgid "Transacciones anuales"
msgstr "Annual transactions"

msgid "Países compradores"
msgstr "Buyer countries"

msgid "Panel operativo (vista previa)"
msgstr "Operations dashboard (preview)"

msgid "Órdenes en período"
msgstr "Orders in period"

msgid "Cumplimiento envíos"
msgstr "Shipment fulfillment"

msgid "Empresas activas"
msgstr "Active companies"

msgid "Señales de confianza"
msgstr "Trust signals"

msgid "Empresas verificadas"
msgstr "Verified companies"

msgid "Catálogo enlazado a compañías con perfil en ZLC."
msgstr "Catalog linked to companies with a CFZ profile."

msgid "Accesos por rol"
msgstr "Role-based access"

msgid "Comprador, vendedor y administración con rutas separadas."
msgstr "Buyer, seller, and admin with separate paths."

msgid "Documentos y órdenes"
msgstr "Documents and orders"

msgid "Flujo de pedidos con estados y base para facturación."
msgstr "Order flow with statuses and a foundation for invoicing."

msgid "Listo para escalar"
msgstr "Built to scale"

msgid "Arquitectura pensada para crecer con más módulos y datos."
msgstr "Architecture designed to grow with more modules and data."

msgid "Caso de uso"
msgstr "Use case"

msgid ""
"“Necesitábamos una vitrina seria para la ZLC: precios claros, stock visible "
"y un back-office que no parezca prototipo. TradeFlow encaja con lo que "
"buscan socios e inversores.”"
msgstr ""
"“We needed a serious storefront for the CFZ: clear prices, visible stock, "
"and a back office that doesn’t feel like a prototype. TradeFlow fits what "
"partners and investors are looking for.”"

msgid "Operaciones B2B · Zona Libre de Colón · Panamá"
msgstr "B2B operations · Colón Free Zone · Panama"

msgid "Por qué TradeFlow"
msgstr "Why TradeFlow"

msgid "Acceso global"
msgstr "Global access"

msgid ""
"Explora ofertas de la ZLC sin fricción y con información clara de cada "
"vendedor."
msgstr ""
"Explore CFZ offers with low friction and clear information for each seller."

msgid "Inventario en vivo"
msgstr "Live inventory"

msgid ""
"Stock y reservas integrados para evitar ventas duplicadas y mejorar la "
"confianza."
msgstr ""
"Integrated stock and reservations to avoid duplicate sales and build trust."

msgid "Documentación"
msgstr "Documentation"

msgid ""
"Base lista para facturas y listas de empaque alineadas a procesos de "
"exportación."
msgstr ""
"A foundation for invoices and packing lists aligned with export processes."

msgid "Pagos trazables"
msgstr "Traceable payments"

msgid ""
"Flujos de pago mock y preparación para integraciones con pasarelas "
"profesionales."
msgstr ""
"Mock payment flows and groundwork for professional gateway integrations."

msgid "Pre-registro"
msgstr "Pre-registration"

msgid ""
"Experiencias de registro y roles separados para compradores y vendedores."
msgstr ""
"Registration experiences and separate roles for buyers and sellers."

msgid "Analítica"
msgstr "Analytics"

msgid ""
"Paneles para administración y vendedores con métricas operativas y "
"comerciales."
msgstr ""
"Dashboards for admins and sellers with operational and commercial metrics."

