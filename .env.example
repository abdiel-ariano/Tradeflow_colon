# Copia este archivo a .env y rellena los valores (no subas .env a git).

SECRET_KEY=cambia-esto-en-desarrollo
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos ---
# Vacío = SQLite (db.sqlite3 en la raíz del proyecto).
#
# Supabase (reemplaza TU_CONTRASENA por la contraseña del proyecto en el panel):
# DATABASE_URL=postgresql://postgres:TU_CONTRASENA@db.ayyukcenmtujsshzoebp.supabase.co:5432/postgres
#
# SSL hacia Postgres (Supabase: suele ser true). Si falla el certificado en local DEBUG, prueba false.
DB_SSL=true

# Sembrado automático: tras migrate, si no hay productos se ejecuta cargar_demo.
# Por defecto igual que DEBUG (en local suele ser true). Desactívalo con:
# SEED_DEMO_IF_EMPTY=false
#
# Usuarios demo tras `python manage.py cargar_demo`: demo_buyer, demo_seller, demo_admin (todos Demo1234!)
# Admin panel app: /dashboard/ con demo_admin | Django admin: /admin/ (mismo usuario tras cargar_demo)
