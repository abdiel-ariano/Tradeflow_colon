# Copia a .env y rellena (no subas .env a git).
# Guía detallada: docs/SUPABASE_GMAIL.md

# OWASP: este archivo es PLANTILLA — NO debe contener credenciales reales.
# Si necesitas un .env funcional para desarrollo, ejecuta:
#   python scripts/bootstrap_dotenv.py

SECRET_KEY=
DEBUG=true
SERVE_LOCAL_MEDIA=true
ALLOWED_HOSTS=127.0.0.1,localhost

# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE (PostgreSQL) — obligatorio para demo inversores / producción
# ═══════════════════════════════════════════════════════════════════════════
# Panel Supabase → Settings → Database → Connection string → URI
# Ejemplo (reemplaza TU_CONTRASENA y el host de tu proyecto):
# DATABASE_URL=postgresql://postgres:TU_CONTRASENA@db.xxxxxxxxxxxx.supabase.co:5432/postgres
#
# Pooler (recomendado en Railway, puerto 5432 session o 6543 transaction):
# DATABASE_URL=postgresql://postgres.xxxx:TU_CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Si la contraseña tiene caracteres especiales (@ : / #), usa variables sueltas:
# SUPABASE_DB_HOST=aws-1-us-east-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_PASSWORD=TU_CONTRASENA
# SUPABASE_PROJECT_REF=xxxx
# (SUPABASE_URL=https://xxxx.supabase.co también corrige el usuario del pooler)

DATABASE_URL=
# DATABASE_PASSWORD=   # opcional: sobreescribe la contraseña embebida en DATABASE_URL
DB_SSL=true
DB_SSLMODE=require

# Tras configurar DATABASE_URL:
#   python manage.py migrate
#   python manage.py cargar_demo
#   python manage.py verify_integrations

# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE — API (Storage; la base de datos usa DATABASE_URL arriba)
# ═══════════════════════════════════════════════════════════════════════════
# Dashboard → Settings → API → Project URL, anon key, service_role key

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Storage bucket for product images (default: media)
SUPABASE_STORAGE_BUCKET=media
# true = public /object/public/ URLs (recommended). false = native signed URLs.
SUPABASE_STORAGE_PUBLIC=true

# ═══════════════════════════════════════════════════════════════════════════
# EMAIL — Resend (https://resend.com)
# ═══════════════════════════════════════════════════════════════════════════
# API key: https://resend.com/api-keys
# El dominio en DEFAULT_FROM_EMAIL / RESEND_FROM_EMAIL debe estar verificado en Resend → Domains.
# Password reset, OTP y correos transaccionales usan RESEND_API_KEY (no EMAIL_BACKEND).
# EMAIL_BACKEND consola solo afecta fallback DEBUG o envíos que aún usen django.core.mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TradeFlow Colón <no-reply@tradeflowcolon.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TradeFlow Colón <no-reply@tradeflowcolon.com>
TRADEFLOW_CONTACT_EMAIL=
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Producción (Railway): https://tradeflowcolon.com
# CSRF_TRUSTED_ORIGINS=https://tradeflowcolon.com,https://www.tradeflowcolon.com
# (opcional; si PUBLIC_BASE_URL es https, se derivan apex + www automáticamente)
# También se agregan hosts concretos de ALLOWED_HOSTS y RAILWAY_PUBLIC_DOMAIN.
# RAILWAY_PUBLIC_DOMAIN=tu-servicio.up.railway.app

# ═══════════════════════════════════════════════════════════════════════════
# OAuth — Google + Outlook (Microsoft) + LinkedIn (signup / login social)
# ═══════════════════════════════════════════════════════════════════════════
# Google Cloud Console → Credentials → OAuth 2.0 Client ID
# Redirect URI prod: https://tradeflowcolon.com/accounts/google/login/callback/
# Redirect URI local: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Azure Portal → App registrations → Redirect URI:
# https://tradeflowcolon.com/accounts/microsoft/login/callback/
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# LinkedIn Developer Portal → Auth → Redirect URLs:
# https://tradeflowcolon.com/accounts/linkedin_oauth2/login/callback/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Quién recibe solicitudes de acceso (/solicitud-acceso/)
APPLICATION_REVIEW_EMAILS=

# Verificación de email al registrarse (true en demo inversores / staging / prod)
# Production should keep true. Set false only for local CI / agile demos.
REQUIRE_EMAIL_VERIFICATION=true
# Optional: detailed /health/ready/?detail=1&token=…
# HEALTH_DETAIL_TOKEN=
# Optional comma-separated Analytics DB hosts allowed in production.
# ANALYTICS_DB_HOST_ALLOWLIST=
# Sellers: trial 30 días + gracia 7 días (ver core/utils/seller_lifecycle.py)
SELLER_TRIAL_DAYS=30
SELLER_GRACE_DAYS=7
# Sellers no requieren UserApplication aprobada (self-serve tras wizard empresa)
REQUIRE_APPROVED_APPLICATION=true
ACCESS_GATING_GRANDFATHER_WITHOUT_APPLICATION=true

# Pagos de plan SaaS (sin Stripe). Producción: ALLOW_MOCK_PLAN_PAYMENT=false
# mock = tarjeta demo inmediata; bank = pending hasta que admin apruebe en Django Admin.
ALLOW_MOCK_PLAN_PAYMENT=true
SELLER_BANK_NAME=Banco General
SELLER_BANK_ACCOUNT_NAME=TradeFlow Colón S.A.
SELLER_BANK_ACCOUNT_NUMBER=
SELLER_BANK_ACCOUNT_TYPE=Corriente
SELLER_BANK_SWIFT=
SELLER_BANK_CURRENCY=USD
# SELLER_BANK_INSTRUCTIONS=Transfiere el monto exacto e indica el ID de checkout en el concepto.

# Cron diario (Railway Cron Job → schedule 0 6 * * *):
#   python manage.py process_seller_subscriptions
# Procesa fin de trial, renovación active→past_due, gracia y emails.
#
# Cron semanal retención logs de seguridad (p.ej. 0 4 * * 0):
#   python manage.py purge_security_logs --days 90

# Staff MFA (TOTP). Default true; se omite automáticamente si EXPO_DEMO_MODE=true.
STAFF_MFA_REQUIRED=true

# Sentry (opcional — OWASP A09). Vacío = no-op.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Checkout: false = empresa debe confirmar (PreExpo). true = pago inmediato (tests).
CHECKOUT_AUTO_APPROVE=false

# ═══════════════════════════════════════════════════════════════════════════
# Dashboard / demo
# ═══════════════════════════════════════════════════════════════════════════
DASHBOARD_KPI_REVENUE_DELIVERED_ONLY=false
SEED_DEMO_IF_EMPTY=true
# Keep true while company identities, prices, stock, or metrics are simulated.
# Set false only after the production catalog has been commercially verified.
DEMO_CATALOG_DISCLOSURE=true

# Cache — REDIS_URL recomendado en producción (compartido entre workers)
# REDIS_URL=redis://default:password@host:6379/0
# USE_DB_CACHE=true   # solo con PostgreSQL; entrypoint corre createcachetable
# CACHE_TTL_HOME=120
# CACHE_TTL_STATS=300
# CACHE_TTL_NAV=600
# CACHE_TTL_CATALOG_META=300
# CACHE_TTL_ACTIVE_COMPANIES=120
# CACHE_TTL_SPOTLIGHTS=120
# CACHE_TTL_MEGA_MENU=180
# CACHE_TTL_SELLER_DASH=45
# SESSION_SAVE_EVERY_REQUEST=false   # default; true = sliding session (más writes a DB)
# TRADEFLOW_USE_PICSUM_RUNTIME=false   # default in prod; bundled seeds in static/images/catalog-seeds/
# python manage.py seed_catalog_images   # assign real category photos to products

# Groq (asistente TF + Analítica IA seller) — opcional
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# ANALYTICS_LLM_MODEL=llama-3.3-70b-versatile  # chat de /mi-tienda/analitica/
# LLM_OFFLINE=1  # fuerza solo gráficas/tablas offline sin llamar al LLM

