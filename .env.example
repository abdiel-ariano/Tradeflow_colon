# Copia este archivo a .env y rellena los valores (no subas .env a git).

SECRET_KEY=cambia-esto-en-desarrollo
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos ---
# Vacío = SQLite (db.sqlite3 en la raíz del proyecto).
# Supabase / Postgres: pega la connection string del panel (modo "URI").
# Ejemplo pooler: postgresql://postgres.xxxx:TU_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# SSL hacia Postgres (Supabase suele requerir true). En DEBUG local puedes probar false si falla el certificado.
DB_SSL=true
