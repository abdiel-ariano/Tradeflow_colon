# Copia a .env y rellena (no subas .env a git).
# Guía detallada: docs/SUPABASE_GMAIL.md

SECRET_KEY=genera-una-clave-larga-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE (PostgreSQL) — obligatorio para demo inversores / producción
# ═══════════════════════════════════════════════════════════════════════════
# Panel Supabase → Settings → Database → Connection string → URI
# Ejemplo (reemplaza TU_CONTRASENA y el host de tu proyecto):
# DATABASE_URL=postgresql://postgres:TU_CONTRASENA@db.xxxxxxxxxxxx.supabase.co:5432/postgres
#
# Pooler (recomendado en Railway/serverless, puerto 6543):
# DATABASE_URL=postgresql://postgres.xxxx:TU_CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Vacío = SQLite local (solo desarrollo rápido sin Supabase)
DATABASE_URL=

DB_SSL=true
DB_SSLMODE=require

# Tras configurar DATABASE_URL:
#   python manage.py migrate
#   python manage.py cargar_demo
#   python manage.py verify_integrations

# ═══════════════════════════════════════════════════════════════════════════
# GMAIL SMTP — correos reales (verificación, órdenes, solicitudes)
# ═══════════════════════════════════════════════════════════════════════════
# 1. Cuenta Google con 2FA
# 2. https://myaccount.google.com/apppasswords → App Password
# 3. Pega la contraseña de 16 caracteres (sin espacios o con espacios, ambos valen)

# Con DEBUG=True y sin EMAIL_BACKEND en .env, TradeFlow usa consola (enlaces en terminal).
# Para Gmail en local: define credenciales abajo y además una de estas opciones:
#   EMAIL_FORCE_SMTP=true
#   o bien: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# En producción (DEBUG=False) con credenciales SMTP, el backend por defecto es SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=tu.correo@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FORCE_SMTP=false

DEFAULT_FROM_EMAIL=TradeFlow <tu.correo@gmail.com>
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Quién recibe solicitudes de acceso (/solicitud-acceso/)
APPLICATION_REVIEW_EMAILS=admin@tradeflow.pa,tu.correo@gmail.com

# Verificación de email al registrarse (false en local ágil, true en demo/prod)
REQUIRE_EMAIL_VERIFICATION=false
REQUIRE_APPROVED_APPLICATION=false
ACCESS_GATING_GRANDFATHER_WITHOUT_APPLICATION=true

# Checkout: false = empresa debe confirmar (PreExpo). true = pago inmediato (tests).
CHECKOUT_AUTO_APPROVE=false

# ═══════════════════════════════════════════════════════════════════════════
# Dashboard / demo
# ═══════════════════════════════════════════════════════════════════════════
DASHBOARD_KPI_REVENUE_DELIVERED_ONLY=false
SEED_DEMO_IF_EMPTY=true

# Groq (asistente TF) — opcional
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
