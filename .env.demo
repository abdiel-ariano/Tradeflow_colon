# =============================================================================
# TradeFlow Colón — .env.demo (SOLO Expo Supérate 2026 / demo en vivo)
# =============================================================================
# NO usar en producción real. Copia a Railway como variables de entorno o:
#   export $(grep -v '^#' .env.demo | xargs)   # Linux (ajusta según tu shell)
#
# Cada flag relaja un gate que bloquearía una demo fluida ante público/inversores.
# El flujo de checkout con confirmación del vendedor (CHECKOUT_AUTO_APPROVE=false)
# se mantiene a propósito — es parte de la historia de producto en escena.
# =============================================================================

# --- Base (completar en Railway antes de la demo) ---
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=

# Postgres/Supabase — obligatorio en Railway (no incluir credenciales aquí)
DATABASE_URL=
DB_SSL=true
DB_SSLMODE=require

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Resend — correos transaccionales en producción
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=
TRADEFLOW_CONTACT_EMAIL=

# Completar con URL real de Railway antes de la demo (enlaces en emails y redirects)
PUBLIC_BASE_URL=

# REQUIRE_APPROVED_APPLICATION=false → nuevos usuarios no necesitan UserApplication
# aprobada por admin para acceder a tienda/checkout (el middleware no bloquea).
REQUIRE_APPROVED_APPLICATION=false

# ACCESS_GATING_GRANDFATHER_WITHOUT_APPLICATION=true → cuentas sin solicitud previa
# (usuarios antiguos o demo) pueden operar aunque REQUIRE_APPROVED_APPLICATION=true.
ACCESS_GATING_GRANDFATHER_WITHOUT_APPLICATION=true

# REQUIRE_EMAIL_VERIFICATION=false → registro/login sin OTP de 6 dígitos antes de comprar.
REQUIRE_EMAIL_VERIFICATION=false

# CHECKOUT_AUTO_APPROVE=false → la empresa confirma la orden (48 h); intencional para la demo.
CHECKOUT_AUTO_APPROVE=false

# EXPO_DEMO_MODE=true → tras OTP válido, auto-aprueba UserApplication y activa cuenta.
EXPO_DEMO_MODE=true

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
APPLICATION_REVIEW_EMAILS=
DASHBOARD_KPI_REVENUE_DELIVERED_ONLY=false
SEED_DEMO_IF_EMPTY=true
