{
  "mcpServers": {
    "open-design": {
      "command": "/absolute/path/to/node",
      "args": [
        "/absolute/path/to/open-design/apps/daemon/bin/od.mjs",
        "mcp",
        "--daemon-url",
        "http://127.0.0.1:7456"
      ],
      "env": {
        "OD_DATA_DIR": "/absolute/path/to/open-design/.od"
      },
      "type": "stdio"
    }
  }
}
